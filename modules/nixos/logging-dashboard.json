{
  "uid": "host-logs",
  "title": "Host logs",
  "description": "Auth, sudo, audit and error lines from the host's journal.",
  "tags": [
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Failed SSH logins",
      "description": "Log lines from sshd that report a failed or refused login, per interval. One attempt can log more than one line.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum(count_over_time({identifier=~\"sshd.*\"} |~ `Failed (password|publickey|keyboard-interactive/pam) for|Invalid user|not allowed because|maximum authentication attempts exceeded` [$__interval])) or vector(0)",
          "legendFormat": "failed logins"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Sudo use",
      "description": "Commands run through sudo, and attempts it refused, per interval.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum(count_over_time({identifier=\"sudo\"} |= `COMMAND=` !~ `NOT in sudoers|NOT authorized|command not allowed|incorrect password attempt` [$__interval])) or vector(0)",
          "legendFormat": "run"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum(count_over_time({identifier=\"sudo\"} |~ `NOT in sudoers|NOT authorized|command not allowed|incorrect password attempt` [$__interval])) or vector(0)",
          "legendFormat": "refused"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Audit events",
      "description": "Kernel audit records that reach the journal, per second.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum(rate({transport=\"audit\"}[$__interval])) or vector(0)",
          "legendFormat": "audit"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "sum(rate({transport=\"kernel\"} |= `audit: type=` [$__interval])) or vector(0)",
          "legendFormat": "kernel audit"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Errors by unit",
      "description": "Log lines of priority error or worse, per interval. Lines that belong to no unit, such as the kernel's, show as none.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "editorMode": "code",
          "queryType": "range",
          "expr": "label_replace(sum by (unit) (count_over_time({container=\"\", level=~\"emerg|alert|crit|error\"} [$__interval])), \"unit\", \"none\", \"unit\", \"^$\")",
          "legendFormat": "{{unit}}"
        }
      ]
    }
  ]
}
